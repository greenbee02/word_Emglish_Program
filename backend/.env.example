# PC에서 API 서버를 실행할 때 사용하는 양식입니다.
# Render 환경변수는 docs/USER_SETUP.md의 Render 전용 표를 사용하세요.
# 아래 DB 연결과 인증 정보는 같은 Supabase 테스트 프로젝트에서 복사합니다.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTO_MIGRATE=false
DB_SSL=true
# Supabase 연결은 DB_SSL=true. 인증서 오류가 나면 프로젝트 CA를 설정합니다.
DB_SSL_CA=
# 이 포트는 PC 실행용입니다. Render에서는 제공되는 PORT를 사용합니다.
PORT=3000
